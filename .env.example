# OpenAI-compatible API for project-source Q&A
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_BASE_URL=https://yunwu.ai/v1
OPENAI_MODEL=gpt-5-mini

# Optional: source repo roots used by the interview AI feature.
# If you clone the sibling repos under the same parent directory,
# the defaults below should work as-is.
INTERVIEW_SOURCE_INSURANCE_RAG_ROOT=../insurance-rag
INTERVIEW_SOURCE_QUORUM_ROOT=../Quorum
